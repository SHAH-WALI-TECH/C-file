#include <stdio.h>
#include <stdlib.h>
struct node
{
    int data;
    struct node *nextnode;
};

void display(struct node *display)
{
    while (display != NULL)
    {
        printf("%d", *(display));
        printf("\n");
        display = display->nextnode;
    }
}

// Creating function to insert node at the Beginning
struct node *insert_at_beginning(struct node *first)
{
    struct node *new_node;
    new_node = (struct node *)malloc(sizeof(struct node));
    printf("Enter the value of node you want to enter at the beginning : ");
    scanf("%d", &new_node->data);
    new_node->nextnode = first;
    first = new_node;
    return first;
}

// Creating function to insert at end

void insert_at_end(struct node *temp, struct node *first, struct node *new_node)
{
    temp = first;
    while (temp->nextnode != NULL)
    {
        temp = temp->nextnode;
    }
    temp->nextnode = new_node;
    new_node->nextnode = NULL;
}

void insert_at_any_location(struct node *temp, struct node *first, struct node *any_location)
{
    int pos;
    int i = 1;
    temp = first;
    printf("Enter the postion you want to insert your node : ");
    scanf("%d", &pos);
    while (i < pos)
    {
        temp = temp->nextnode;
        i++;
    }
    any_location->nextnode = temp->nextnode;
    temp->nextnode = any_location;
}

int main()
{
    struct node *first, *second, *third, *fourth, *new_node, *any_location, *temp;
    first = (struct node *)malloc(sizeof(struct node));
    second = (struct node *)malloc(sizeof(struct node));
    third = (struct node *)malloc(sizeof(struct node));
    fourth = (struct node *)malloc(sizeof(struct node));

    // Assigning values to the pointers and linked them together so they form linked list

    first->data = 1;
    first->nextnode = second;

    second->data = 2;
    second->nextnode = third;

    third->data = 3;
    third->nextnode = fourth;

    fourth->data = 4;
    fourth->nextnode = NULL;

    // simply calling display and insertion at beginning to check my linked list after insertion at beginning

    printf("Printing link list without doing anything");
    printf("\n");
    display(first);

    first = insert_at_beginning(first);
    printf("Printing link list after insert one node at the beginning");
    printf("\n");
    display(first);

    new_node = (struct node *)malloc(sizeof(struct node));
    printf("Enter the value of node you want to enter at the end : ");
    scanf("%d", &new_node->data);
    printf("printing link list after insert the node at the end  ");
    printf("\n");

    insert_at_end(temp, first, new_node);
    display(first);

    any_location = (struct node *)malloc(sizeof(struct node));
    printf("Enter the value of the node you want to enter at any location ");
    scanf("%d", &any_location->data);
    printf("Printing link list after insertnode at any location");
    printf("\n");

    insert_at_any_location(temp, first, any_location);
    printf("\n");
    display(first);
}
